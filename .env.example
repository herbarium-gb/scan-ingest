# Copy this file to .env and fill in your values

# Paths (override config.yml defaults for this server)
INBOX_DIR=/data/upload
DONE_JP2_DIR=/data/done/jp2
DONE_TIF_DIR=/data/done/tif
DONE_FOLDERS_DIR=/data/done/folders
ERROR_DIR=/data/error
LOG_DIR=/data/logs

# FileMaker Data API — used by filemaker_test.py (seed of the future
# Postgres -> FileMaker sync). No trailing slash on the base URL.
FM_BASE_URL=https://your-filemaker-server.example.com
FM_DATABASE=Herbariet_databas_test
FM_LAYOUT=Scan_import
FM_USER=Scan-importer
FM_PASSWORD=
