# Copy this file to .env and fill in your values

# --- Paths -----------------------------------------------------------
# Unset, each falls back to config.yml's relative default (done/, error/,
# logs/, ... inside wherever ingest.py is run from) — fine for local dev,
# but in production set all three, keeping LOCAL_STATE_DIR out of both the
# image storage and the code checkout.
INBOX_DIR=/mnt/scan-inbox
IMAGE_STORAGE_DIR=/mnt/image-storage  # -> Delivery/ (served by IIIF; herbarium-
                                       # platform's IMAGE_DATA_PATH), archive/
                                       # (lossless copies, not served)
LOCAL_STATE_DIR=../scan-ingest-state  # -> tif/, error/, logs/ (sibling to the
                                       # code checkout, wherever that is — no
                                       # root needed, unlike a real /var path)

# Optional overrides: DONE_JP2_DIR, DONE_JP2_LOSSLESS_DIR, DONE_TIF_DIR,
# ERROR_DIR, LOG_DIR — each wins over IMAGE_STORAGE_DIR/LOCAL_STATE_DIR above.

# For a local sandbox, ${VAR} references to an earlier line in this file
# work (unlike bare $VAR) — e.g. one shared root with a mount/ and a state/
# subfolder, instead of three full paths:
#   SANDBOX_DIR=/path/to/local/sandbox
#   INBOX_DIR=${SANDBOX_DIR}/mount/upload
#   IMAGE_STORAGE_DIR=${SANDBOX_DIR}/mount
#   LOCAL_STATE_DIR=${SANDBOX_DIR}/state
# scripts/reset_local_test_output.py refills the inbox from TEST_TIFF_DIR
# (optional), and only runs in a sandbox marked with a .test-sandbox file:
#   TEST_TIFF_DIR=/path/to/sample/tiffs

# --- herbarium-platform ------------------------------------------------
# Used to update the viewer's shard index after each run, and to check that
# a scan isn't already archived before filing it. Always set in production:
# unset, the shard update is skipped and only files that already exist at
# the destination are protected. SHARD_TARGET = the shards the viewer serves.
HERBARIUM_PLATFORM_DIR=/path/to/herbarium-platform
SHARD_TARGET=prod  # local | stage | prod

# --- FileMaker API (optional) ------------------------------------------
# ingest.py creates an empty record per sheet (AccessionNo, Löpnr, Image1,
# FolderQR).
# Skipped entirely if FM_BASE_URL is unset. Also used by the scripts in
# scripts/filemaker_*.py. No trailing slash on the base URL.
FM_BASE_URL=https://your-filemaker-server.example.com
FM_DATABASE=your-filemaker-database
FM_LAYOUT=your-filemaker-layout
FM_USER=your-filemaker-account
FM_PASSWORD=
