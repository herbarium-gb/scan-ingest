# Copy this file to .env and fill in your values

# --- Paths (override config.yml's relative defaults) ---
#
# Three grouped path variables:
#   INBOX_DIR          where BookEye's SMB share lands
#   IMAGE_STORAGE_DIR   the image storage server — gives $IMAGE_STORAGE_DIR/jp2
#                       (this *is* herbarium-platform's IMAGE_DATA_PATH tree)
#                       and $IMAGE_STORAGE_DIR/jp2_lossless (a separate
#                       top-level folder there, archival only, never read
#                       by RAIS/IIIF)
#   LOCAL_STATE_DIR     wherever ingest.py itself runs — gives
#                       $LOCAL_STATE_DIR/tif (temporary, not the long-term
#                       archive), $LOCAL_STATE_DIR/error, and
#                       $LOCAL_STATE_DIR/logs (including the FileMaker
#                       import CSV staff pick up from here)
INBOX_DIR=/data/upload
IMAGE_STORAGE_DIR=/data/delivery
LOCAL_STATE_DIR=/data/scan-ingest

# Escape hatch: any of these six still overrides the grouped vars above,
# for a one-off redirect of a single path without abandoning the rest:
# DONE_JP2_DIR=...
# DONE_JP2_LOSSLESS_DIR=...
# DONE_TIF_DIR=...
# ERROR_DIR=...
# LOG_DIR=...

# Local dev/testing only: DATA_DIR points ALL of the above at one shared
# folder instead (upload/, done/jp2, done/jp2_lossless, done/tif, error/,
# logs/) — convenient for a single machine, wrong for production since it
# lumps image storage and local operational state together. Lowest
# precedence — everything above still overrides it.
# DATA_DIR=...

# FileMaker Data API — used by filemaker_test.py (seed of the future
# Postgres -> FileMaker sync). No trailing slash on the base URL.
FM_BASE_URL=https://your-filemaker-server.example.com
FM_DATABASE=Herbariet_databas_test
FM_LAYOUT=Scan_import
FM_USER=Scan-importer
FM_PASSWORD=
