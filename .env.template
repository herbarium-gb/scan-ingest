# Copy this file to .env and fill in your values

# --- Paths (override config.yml's relative defaults) ---
#
# Production: set each path individually — they belong on different
# storage, not one shared folder:
#   INBOX_DIR              where BookEye's SMB share lands
#   DONE_JP2_DIR            the image storage server — this *is*
#                           herbarium-platform's IMAGE_DATA_PATH tree,
#                           no separate copy step
#   DONE_JP2_LOSSLESS_DIR   image storage server too, but a different
#                           top-level folder — archival only, never read
#                           by RAIS/IIIF
#   DONE_TIF_DIR            local to wherever ingest.py runs — temporary,
#                           not the long-term archive (the lossless JP2 is)
#   ERROR_DIR               local to wherever ingest.py runs — so staff
#                           find failures next to the code, not buried in
#                           the image archive
#   LOG_DIR                 local to wherever ingest.py runs — operational
#                           state belongs with the running code, including
#                           the FileMaker import CSV staff pick up from here
INBOX_DIR=/data/upload
DONE_JP2_DIR=/data/delivery
DONE_JP2_LOSSLESS_DIR=/data/archive
DONE_TIF_DIR=/data/scan-ingest/tif
ERROR_DIR=/data/scan-ingest/error
LOG_DIR=/data/scan-ingest/logs

# Local dev/testing only: DATA_DIR points all six paths above at one shared
# folder instead (upload/, done/jp2, done/jp2_lossless, done/tif, error/,
# logs/) — convenient for a single machine, wrong for production. Any of
# the individual vars above still overrides it for that one path.
# DATA_DIR=...

# FileMaker Data API — used by filemaker_test.py (seed of the future
# Postgres -> FileMaker sync). No trailing slash on the base URL.
FM_BASE_URL=https://your-filemaker-server.example.com
FM_DATABASE=Herbariet_databas_test
FM_LAYOUT=Scan_import
FM_USER=Scan-importer
FM_PASSWORD=
